{
  "id": "targeted-media-export-fetch",
  "group": "lifecycle",
  "requires": [
    "capability:mediaExportByMessage",
    "endpoint:media_export",
    "endpoint:media",
    "slot:targeted_media"
  ],
  "note": "按完整消息身份定向导出并取实际句柄，媒体字节非空；不依赖默认消息页。",
  "ops": [
    {
      "req": {
        "POST": "{endpoints.media_export}",
        "slot": "targeted_media",
        "body": {
          "talker": "{slots.targeted_media.id}",
          "platformMessageId": "{slots.targeted_media.expect.platformMessageId}",
          "sender": "{slots.targeted_media.expect.sender}",
          "timestamp": "{slots.targeted_media.expect.timestamp}"
        }
      },
      "save": {
        "slot:targeted_media": "mediaId"
      },
      "assert": [
        "targeted_media_export_handle"
      ]
    },
    {
      "req": {
        "GET": "{endpoints.media}",
        "slot": "targeted_media",
        "expect": "bytes"
      },
      "assert": [
        "media_fetch_bytes_nonempty"
      ]
    }
  ]
}
